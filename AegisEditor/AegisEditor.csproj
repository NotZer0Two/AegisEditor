<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <OutputType>Library</OutputType>
        <PlatformTarget>x64</PlatformTarget>

        <LangVersion>13.0</LangVersion>
        <Platforms>AnyCPU</Platforms>
        <Nullable>disable</Nullable>
        <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>

        <AssemblyName>AegisEditor</AssemblyName>
        <RootNamespace>AegisEditor</RootNamespace>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <nullable>enable</nullable>
        <NoWarn>CS0649</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" ExcludeAssets="runtime" />
        <PackageReference Include="Lib.Harmony" Version="2.2.2" ExcludeAssets="runtime" />
    </ItemGroup>
    
    <ItemGroup>
        <Reference Include="System" Private="false" />
        <Reference Include="System.Core" Private="false" />
        <Reference Include="mscorlib" Private="false" />
        <Reference Include="System.Data" Private="false" />
        <Reference Include="System.Data.DataSetExtensions" Private="false" />
        <Reference Include="Assembly-CSharp-firstpass" Private="false" />
        <Reference Include="LabApi" Private="false" />
        <Reference Include="Assembly-CSharp" Publicize="true" Private="false" />
        <Reference Include="NorthwoodLib" Private="false" />
        <Reference Include="Pooling" Private="false" />
        <Reference Include="CommandSystem.Core" Private="false" />
        <Reference Include="UnityEngine.CoreModule" Publicize="true" Private="false" />
        <Reference Include="UnityEngine.PhysicsModule" Private="false" />
        <Reference Include="UnityEngine.AssetBundleModule" Private="false" />
        <Reference Include="Unity.TextMeshPro" Private="false" />
        <Reference Include="Mirror" Publicize="true" Private="false" />
        <Reference Include="YamlDotNet" Private="false" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\AegisEditor.API\AegisEditor.API.csproj" />
    </ItemGroup>
</Project>